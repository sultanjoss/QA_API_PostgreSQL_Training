{
  "info": {
    "name": "QA API + PostgreSQL Training Lab",
    "description": "Dummy API basic-to-intermediate. Import ke Postman, lalu Run Collection secara urut. Satu backend localhost, DB terpisah dari ReportPortal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('DB connected',()=>pm.expect(pm.response.json().database).to.eql('CONNECTED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 List customers",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customers?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Array data',()=>pm.expect(pm.response.json().data).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create customer unique",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA Postman\",\"email\":\"{{uniqueEmail}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('uniqueEmail', `qa-postman-${Date.now()}@example.test`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){pm.collectionVariables.set('customerId',pm.response.json().id);}",
              "pm.test('Response time < 3000ms (lab)',()=>pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get newly created customer",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customers/{{customerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "{{customerId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA Postman\",\"email\":\"{{uniqueEmail}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409',()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Create account for customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"customer_id\":{{customerId}},\"initial_balance\":50000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set('accountId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Read new account",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "accounts",
            "{{accountId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Transfer between seeded accounts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{transferKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transfers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"source_account_id\":1,\"target_account_id\":2,\"amount\":1000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('transferKey', `qa-postman-tx-${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 first transfer',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201)pm.collectionVariables.set('transferId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Read transfer",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/transfers/{{transferId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transfers",
            "{{transferId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Invalid customer email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"QA\",\"email\":\"invalid-email\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountId",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    },
    {
      "key": "transferKey",
      "value": ""
    },
    {
      "key": "uniqueEmail",
      "value": ""
    }
  ]
}
